# Copia este archivo como .env (el .env NUNCA se sube a git).

# "chrome" usa tu Google Chrome instalado; déjalo vacío para usar el
# Chromium que descarga Playwright.
BROWSER_CHANNEL=chrome
OUTPUT_DIR=output
# Perfil propio del navegador del script (se reutiliza entre corridas para que
# reCAPTCHA no lo trate como un navegador nuevo cada vez). Vacío = temporal.
BROWSER_PROFILE_DIR=.browser-profile
# Segundos para resolver cada CAPTCHA.
CAPTCHA_TIMEOUT_S=600

# --- Fase 2 (extractor de artículos) ---
NVIDIA_API_KEY=
# Comparado el 30/09/2026 con el artículo de Mues: Gemma 29 s, GLM 45 s, Nemotron 66-110 s
# (mismo resultado en los tres).
NVIDIA_MODEL=google/gemma-4-31b-it
# Tokens para la respuesta (los modelos de razonamiento piensan antes de contestar).
NVIDIA_MAX_TOKENS=8192
# Si NVIDIA está saturado (error 503), espera y reintenta hasta este total de segundos.
NVIDIA_RETRY_MAX_S=300
# Opcional: modelos de NVIDIA (separados por coma) para usar cuando el principal
# está saturado. Los retirados se saltan solos. Prueba cada uno antes con:
#   python run_article.py mues --dry-run --model <modelo>
NVIDIA_FALLBACK_MODEL=z-ai/glm-5.3-flash,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Vacío = prueba guided_json, nvext.guided_json, json_object y texto, en ese orden.
NVIDIA_JSON_MODE=

# --- Fase 3 (worker + Supabase sandbox) ---
SUPABASE_URL=https://wajqomlfygiyxzrppuup.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
